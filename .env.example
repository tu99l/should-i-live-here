# Copy this file to .env and fill in your own keys. Never commit .env.

# From Google AI Studio (aistudio.google.com). Used to parse listings and write explanations.
GEMINI_API_KEY=your-gemini-key-here
# Current Flash model as of Oct 2026. gemini-3.5-flash-lite is faster but catches fewer red flags.
GEMINI_MODEL=gemini-3.8-flash

# From the Google Cloud console with the Routes API enabled. Set a billing cap first.
# Leave blank to use only the walk times saved in data/demo_listings.json.
GOOGLE_MAPS_API_KEY=

# Where commute times are measured to.
DESTINATION=Royce Hall, UCLA, Los Angeles, CA

# Optional: the iMessage bot (app/photon_bot.py). From the Photon dashboard (app.beta.photon.codes).
PHOTON_API_KEY=pho_sk_your-photon-key-here
PHOTON_PROJECT_ID=pho_prj_your-project-id

# Optional: real rental listings near the group's place (app/rentcast.py). rentcast.io, free Developer plan
# (50 requests/month; each search is cached, so one area costs one request).
RENTCAST_API_KEY=your-rentcast-key-here
